# ===================================================
# SECOND STORY — ENVIRONMENT CONFIGURATION
# ===================================================

# Environment
NODE_ENV=development
APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=mstbrand

# Authentication (At least 32 characters for AES-256 JWT encryption)
AUTH_SECRET=second-story-super-secret-key-32-chars-long-2026-secure

# Razorpay (India Payments)
# For test mode, generate test keys at: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# Media Storage (Cloudinary - Optional for cloud uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notifications (SendGrid / Resend / SMTP abstraction)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=orders@secondstory.vintage

# Admin Bootstrap
BOOTSTRAP_ADMIN_EMAIL=ajaypawar5565@gmail.com
